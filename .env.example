# Placeholder-only template. Copy to .env only if no .env already exists.
# Never commit .env; it is plaintext. Existing process environment wins.
AZURE_OPENAI_BASE=https://your-resource.openai.azure.com
BRIDGE_APPROVED_ORIGINS='["https://your-resource.openai.azure.com"]'
AZURE_OPENAI_API_KEY=replace-with-your-azure-resource-key
# Exact visible ASCII token, no whitespace; do not reuse the Azure credential.
BRIDGE_PROXY_TOKEN=replace-with-a-different-local-bearer-token

# Azure deployment identity is distinct from the outward client alias.
AZURE_OPENAI_MODEL=your-gpt6-deployment
AZURE_OPENAI_VARIANT=gpt-6-luna
AZURE_OPENAI_VERSION=2026-09-22
BRIDGE_MODEL_ALIAS=gpt-6-local
BRIDGE_PORT=8787

# Optional single-route operator profile assertion; no automatic Azure discovery.
# Images and pro mode are gated off by default. PTU-M has no breakpoints.
# BRIDGE_MODEL_PROFILE='{"deploymentType":"ptu-m"}'
# BRIDGE_MODEL_PROFILE='{"images":false,"reasoningModes":["standard","pro"]}'

# Alternative multi-route map overrides the single-route AZURE_OPENAI_* identity.
# BRIDGE_MODEL_ALIAS must name one entry. Profiles are validated separately.
# BRIDGE_MODELS='{"gpt-6-local":{"deployment":"your-luna-deployment","variant":"gpt-6-luna","version":"2026-09-22"},"gpt-6-sol-local":{"deployment":"your-sol-deployment","variant":"gpt-6.1-sol","version":"2026-09-29"}}'

BRIDGE_INSTRUCTION_POLICY=reject-mixed
BRIDGE_SAMPLING_POLICY=reject
# drop-defaults removes only incompatible temperature/top_p exactly equal to 1.
# Never silently replaces an explicit effort; verify actual WorkBuddy defaults first.
# BRIDGE_SAMPLING_POLICY=drop-defaults

# Omitted reasoning settings stay omitted; a configured default applies to all routes.
# BRIDGE_REASONING_EFFORT=low
# BRIDGE_REASONING_MODE=standard
# BRIDGE_REASONING_CONTEXT=current_turn
BRIDGE_MAX_OUTPUT_TOKENS=128000

# Stateless by default; stored-response chaining is NOT implemented.
BRIDGE_ALLOW_STORE=false
BRIDGE_STORE_DEFAULT=false

# Message properties treated as ignored WorkBuddy client metadata.
# Default covers the observed 5.8.3 fields; names are validated, bounded, never
# forwarded, and may not claim a standard or reserved message field.
# BRIDGE_CLIENT_METADATA_FIELDS='["startsNewUserRequest","agent","conversationRequestId"]'
# "auto" (default) also ignores other non-standard message-level keys after
# bounded validation, logging only their names. "strict" rejects anything not
# listed above. Standard/reserved message fields fail in both modes.
# BRIDGE_CLIENT_METADATA_MODE=auto

# Stable, non-secret prefix-family key; not a guaranteed cache hit.
# No implicit default breakpoints are inserted by the bridge.
# BRIDGE_PROMPT_CACHE_KEY=workbuddy:stable-instructions-v1
# BRIDGE_PROMPT_CACHE_OPTIONS='{"mode":"implicit","ttl":"30m"}'
# Standard pay-as-you-go only: explicit with no breakpoints disables caching/writes.
# BRIDGE_PROMPT_CACHE_OPTIONS='{"mode":"explicit","ttl":"30m"}'

# Limits are bytes, not tokens; concurrency also bounds memory exposure.
# BRIDGE_LIMITS='{"requestBytes":8388608,"jsonBytes":33554432,"errorBytes":65536,"sseLineBytes":16777216,"sseEventBytes":16777216,"sseBufferBytes":16777216,"responseBytes":67108864,"maxConcurrent":4}'
# All timeouts are positive milliseconds (total lifetime includes upstream work).
# BRIDGE_TIMEOUTS='{"uploadMs":30000,"upstreamIdleMs":300000,"downstreamStallMs":30000,"totalMs":1800000,"shutdownMs":5000}'
# BRIDGE_LOG_PATH=C:\Users\your-user\azure-bridge\bridge.log
# BRIDGE_MAX_LOG_BYTES=10485760
# Daily archives bridge-YYYY-MM-DD.log; older ones are deleted after this many days.
# BRIDGE_LOG_RETENTION_DAYS=7

# Windows launcher Node selection happens before dotenv loading.
# Set the PROCESS variable BRIDGE_NODE or use -NodePath (not an entry in .env).
# Example PowerShell: $env:BRIDGE_NODE = 'C:\Program Files\nodejs\node.exe'
