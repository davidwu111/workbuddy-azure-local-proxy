# Copy to .env (chmod 600 .env) and replace every placeholder.
# Bind to THIS Linux host's LAN IPv4, not 0.0.0.0 or 127.0.0.1 for remote PCs.
BRIDGE_HOST=YOUR_LAN_IPV4
BRIDGE_PORT=8787
AZURE_OPENAI_BASE=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_API_KEY
AZURE_OPENAI_MODEL=YOUR_DEPLOYMENT_NAME
# Use a separate random token, e.g. generate with `openssl rand -hex 32`.
BRIDGE_PROXY_TOKEN=YOUR_RANDOM_PROXY_TOKEN
# Optional: for HTTPS, configure BOTH TLS file paths and trust the certificate on clients.
# BRIDGE_TLS_CERT=/path/to/bridge.crt
# BRIDGE_TLS_KEY=/path/to/bridge.key
